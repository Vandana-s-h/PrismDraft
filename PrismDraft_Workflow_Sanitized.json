    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a professional LinkedIn post using the following content.\n\nTitle: {{$json.title}}\n\nAuthor: {{$json.author}}\n\nSource Content:\n{{$json.body_text}}\n\nGenerate an engaging LinkedIn post with key takeaways\nand relevant hashtags.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert LinkedIn content strategist and copywriter.  Your task is to transform long-form content into an engaging, professional LinkedIn post.  Follow these rules: 1. Start with a powerful attention-grabbing hook. 2. Preserve the original facts and meaning. 3. Use short, readable paragraphs. 4. Include exactly 3 important key takeaways. 5. End with an engaging question or call to action. 6. Include 3 to 5 relevant hashtags. 7. Never invent statistics or facts. 8. Write in a professional but conversational tone.  Return the generated LinkedIn post clearly."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
