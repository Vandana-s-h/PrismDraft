    {
      "parameters": {
        "promptType": "define",
        "text": "=Create an engaging X/Twitter thread using the\nfollowing source content.\n\nTitle: {{$json.title}}\n\nAuthor: {{$json.author}}\n\nSource Content:\n{{$json.body_text}}\n\nGenerate a connected thread of 3 to 5 tweets.\nEach tweet must contain fewer than 280 characters.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert X/Twitter content strategist.  Your task is to transform long-form content into an engaging Twitter thread.  Rules: 1. Generate 3 to 5 tweets. 2. Tweet 1 must have a powerful hook. 3. Every tweet must be under 280 characters. 4. Each tweet should communicate one clear idea. 5. Maintain a logical sequence. 6. Preserve all important facts. 7. Do not invent statistics or information. 8. Make the thread engaging and easy to read.  Format your response as:  Tweet 1: [Content]  Tweet 2: [Content]  Tweet 3: [Content]  Continue up to 5 tweets if needed."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        0,
        0
      ],
      "id": "5dc0daa0-45b3-441d-aeb6-4c9fb4fd4c08",
      "name": "X Thread – AI Generator"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create an executive summary and professional email\nnewsletter using the following source content.\n\nTitle: {{$json.title}}\n\nAuthor: {{$json.author}}\n\nSource Content:\n{{$json.body_text}}\n\nGenerate:\n1. Exactly 3 executive summary bullet points.\n2. A complete professional email newsletter.\n3. An engaging email subject line.\n4. A short email preview.\n\nPreserve the original facts and meaning.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert executive communications writer and professional newsletter editor.  Your task is to transform long-form content into a concise executive summary and engaging newsletter.  EXECUTIVE SUMMARY: 1. Write exactly 3 concise bullet points. 2. Include the most important information. 3. Make each point clear and informative.  NEWSLETTER: 1. Create an engaging subject line. 2. Write a short preheader. 3. Start with a welcoming introduction. 4. Explain the important ideas from the source. 5. Use short, readable paragraphs. 6. End with a professional closing and call to action.  IMPORTANT: - Preserve factual accuracy. - Never invent statistics. - Do not introduce unsupported information. - Use professional but accessible language.  Return the output in this format:  EXECUTIVE SUMMARY: 1. 2. 3.  EMAIL SUBJECT:  PREHEADER:  NEWSLETTER BODY:"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        592,
        32
      ],
      "id": "a747994a-08d5-4168-b015-cc313ddfbfd0",
